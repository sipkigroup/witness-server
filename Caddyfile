# TLS terminator for the witness (profile "https"). Caddy gets a Let's Encrypt certificate for DW_DOMAIN automatically:
# the name must resolve to this host and ports 80/443 must be reachable. Own certificate instead: replace the first line inside
# the block with `tls /certs/fullchain.pem /certs/key.pem` and mount ./certs:/certs:ro in docker-compose.yml.
# Closed network try-out: `tls internal` (Caddy's own CA; clients must trust its root from the "caddy" volume).
{$DW_DOMAIN} {
	request_body {
		max_size 256KB
	}
	reverse_proxy witness:8787 {
		# The witness takes the client IP for its per-IP limits from X-Real-IP: always OVERWRITE what the client sent.
		header_up X-Real-IP {remote_host}
	}
	# The witness itself does not answer (stopped, restarting, overloaded): say so in words, with the status page kept OFF this
	# server (DW_STATUS_URL in .env; .github/workflows/status.yml), instead of an empty 502.
	handle_errors 502 503 504 {
		header Content-Type "text/plain; charset=utf-8"
		header Retry-After "30"
		respond "The witness is not answering right now (HTTP {err.status_code}). Calls of your agents that need it are refused; nothing runs without it. Status page: {$DW_STATUS_URL:none set by this operator}" {err.status_code}
	}
}
