# Copy to .env (cp env.example .env) and change what you need. Every line is optional; the values shown are the defaults.

# --- Where the witness is reached -------------------------------------------------------------------
# Local (default): http://localhost:8787 on this machine only.
DW_DOMAIN=localhost
DW_PUBLIC_URL=http://localhost:8787
DW_PORT=8787
DW_SECURE_COOKIE=0
# Your domain with HTTPS (start with: docker compose --profile https up -d --build):
#DW_DOMAIN=witness.example.org
#DW_PUBLIC_URL=https://witness.example.org
#DW_SECURE_COOKIE=1
#DW_HTTP_PORT=80
#DW_HTTPS_PORT=443

# --- Accounts -----------------------------------------------------------------------------------
# on  = "trial" accounts: whoever reaches the witness can make an account with one passkey (no e-mail).
#       Right for a witness on localhost or inside a closed network.
# off = only accounts made at /signup.html; turn it off before you open the witness to the internet.
DW_TRIAL=on

# --- Time anchors (both off = nothing leaves your network) --------------------------------------
DW_ANCHOR=off
#DW_TSA_URL=https://tsa.example.org/tsr     # RFC 3161 time stamp of every batch root; needs DW_TSA_CA
#DW_TSA_CA=/data/tsa-root.pem
#DW_TSA_NAME=corp-tsa

# --- Limits -------------------------------------------------------------------------------------
DW_RATE_PER_MIN=60
DW_QUOTA_PER_DAY=5000
DW_MAX_AGENTS=3
DW_REG_PER_HOUR=10

# --- Docker -------------------------------------------------------------------------------------
DW_PROJECT=deus-witness      # compose project name (volumes are named <project>_data, <project>_secrets)
DW_VERSION=0.2.107            # image tag
DW_NET=172.29.80             # private /24 of the compose network; change if it clashes with yours
