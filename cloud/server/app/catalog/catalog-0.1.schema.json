{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "witness-catalog-0.1.schema.json",
  "title": "witness-catalog 0.1",
  "type": "object",
  "required": ["catalog", "version", "released", "verdict_order", "classes"],
  "additionalProperties": false,
  "properties": {
    "catalog": {"const": "witness-catalog"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "released": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "note": {"type": "string"},
    "verdict_order": {"type": "array", "items": {"enum": ["N", "D", "A1", "A", "C", "S"]}, "minItems": 6},
    "classes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/class"}}
  },
  "$defs": {
    "verdict": {"enum": ["N", "D", "A1", "A", "C", "S"]},
    "class": {
      "type": "object",
      "required": ["id", "rev", "status", "title", "effect", "axes", "verdict", "override", "words", "refs"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^wa\\.[a-z0-9]+\\.[a-z0-9-]+$"},
        "rev": {"type": "integer", "minimum": 1},
        "status": {"enum": ["observe", "enforce", "retired"]},
        "title": {"type": "string", "minLength": 1},
        "effect": {"type": "string", "minLength": 1},
        "article": {"type": "integer", "minimum": 1},
        "marks": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "codes": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z_]+$"}},
        "axes": {
          "type": "object",
          "required": ["irrev", "egress", "secret", "persist", "weaken", "money", "others", "origin", "scale", "certainty"],
          "additionalProperties": false,
          "properties": {
            "irrev": {"enum": ["none", "shadow", "git", "irreversible"]},
            "egress": {"enum": ["none", "read", "send", "publish"]},
            "secret": {"enum": ["none", "name", "read", "send"]},
            "persist": {"enum": ["none", "later-run", "login", "agent-next"]},
            "weaken": {"enum": ["none", "own", "os"]},
            "money": {"enum": ["none", "le_threshold", "gt_threshold"]},
            "others": {"enum": ["none", "others-data", "others-system"]},
            "origin": {"enum": ["any", "own", "project", "agent-written", "net-session"]},
            "scale": {"enum": ["one", "many", "rate"]},
            "certainty": {"enum": ["certain", "uncertain"]}
          }
        },
        "verdict": {
          "type": "object",
          "required": ["default", "strict_sandbox", "offline", "uncertain"],
          "additionalProperties": false,
          "properties": {
            "default": {"$ref": "#/$defs/verdict"},
            "strict_sandbox": {"$ref": "#/$defs/verdict"},
            "offline": {"$ref": "#/$defs/verdict"},
            "uncertain": {"$ref": "#/$defs/verdict"}
          }
        },
        "override": {"enum": ["none", "once", "forever", "exception"]},
        "words": {
          "type": "object",
          "required": ["what", "harm"],
          "additionalProperties": false,
          "properties": {"what": {"type": "string", "minLength": 1}, "harm": {"type": "string", "minLength": 1}}
        },
        "refs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[A-Za-z-]+:[A-Za-z0-9.-]+$"}},
        "detectors": {"type": "array", "items": {"type": "string"}},
        "vectors": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "match": {"type": "array", "items": {"$ref": "#/$defs/vector"}},
            "not_match": {"type": "array", "items": {"$ref": "#/$defs/vector"}}
          }
        }
      }
    },
    "vector": {
      "type": "object",
      "required": ["tool", "command"],
      "additionalProperties": false,
      "properties": {
        "tool": {"type": "string"},
        "command": {"type": "string"},
        "expect": {"$ref": "#/$defs/verdict"},
        "expect_not": {"$ref": "#/$defs/verdict"}
      }
    }
  }
}
